# Gabi Cake - variáveis de ambiente
#
# Como usar: cp .env.example .env   e ajuste os valores.
# Nunca envie o .env ao Git (só o .env.example vai para o repositório).

# Fuso horário da loja, usado por banco, backend e frontend.
# Evita horários deslocados na agenda.
APP_TZ=America/Fortaleza

# Nome do banco de dados.
POSTGRES_DB=gabicake

# Usuário do banco (o backend usa o mesmo).
POSTGRES_USER=gabicake

# Senha do banco. OBRIGATÓRIA: troque por uma senha própria.
POSTGRES_PASSWORD=troque_esta_senha

# Porta do seu computador para acessar o banco (DBeaver, pgAdmin, psql).
DB_HOST_PORT=5432

# Porta da API (backend). Acesso: http://localhost:8080/actuator/health
BACKEND_PORT=8080

# Porta para ver a interface JavaFX no navegador.
# Acesso: http://localhost:6080/vnc.html?autoconnect=true&resize=scale
FRONTEND_PORT=6080
